# Dolomites Planner - Environment Variables
# Nukopijuokite šį failą į .env ir užpildykite reikšmes

# Google Maps JavaScript API raktas
# Gaukite iš: https://console.cloud.google.com/
# Reikalingi API: Maps JavaScript API, Directions API
VITE_GOOGLE_MAPS_API_KEY=jūsų_raktas_čia

# Firebase Cloud Firestore konfigūracija
# Gaukite iš: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=jūsų_api_key_čia
VITE_FIREBASE_AUTH_DOMAIN=jūsų_auth_domain_čia
VITE_FIREBASE_PROJECT_ID=jūsų_projektas_čia
VITE_FIREBASE_STORAGE_BUCKET=jūsų_storage_bucket_čia
VITE_FIREBASE_MESSAGING_SENDER_ID=jūsų_sender_id_čia
VITE_FIREBASE_APP_ID=jūsų_app_id_čia

